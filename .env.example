# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Path Model GGUF Lokal (Opsional, default: model/model.gguf)
LOCAL_MODEL_PATH=model/model.gguf

# Konfigurasi Database MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hematuang_db

# Kunci Enkripsi Data Transaksi (AES-Fernet)
ENCRYPTION_KEY=generate_your_fernet_key_here
